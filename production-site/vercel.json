{
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fullchoicebreath.com"
        }
      ],
      "destination": "https://www.dipatmawellness.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fullchoicebreath.com"
        }
      ],
      "destination": "https://www.dipatmawellness.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dipatmawellness.com"
        }
      ],
      "destination": "https://www.dipatmawellness.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about/",
      "destination": "/index.html"
    },
    {
      "source": "/approach/",
      "destination": "/index.html"
    },
    {
      "source": "/solutions/",
      "destination": "/index.html"
    },
    {
      "source": "/impact-advisory/",
      "destination": "/index.html"
    },
    {
      "source": "/insights/",
      "destination": "/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/index.html"
    }
  ]
}